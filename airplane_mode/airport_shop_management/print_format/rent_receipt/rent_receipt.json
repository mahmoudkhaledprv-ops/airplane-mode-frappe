 "html": "<div class=\"print-format\" style=\"font-family: Arial, sans-serif; padding: 25px;\">\n\n    <div style=\"text-align: center; border-bottom: 2px solid #222; padding-bottom: 15px;\">\n        <h2 style=\"margin-bottom: 5px;\">AIRPORT SHOP MANAGEMENT</h2>\n        <h3 style=\"color: #555;\">RENT PAYMENT RECEIPT</h3>\n    </div>\n\n    <div style=\"margin-top: 25px;\">\n        <table style=\"width: 100%; border-collapse: collapse;\">\n\n            <tr>\n                <td style=\"padding: 10px;\"><strong>Payment Reference:</strong></td>\n                <td>{{ doc.name }}</td>\n            </tr>\n\n            <tr>\n                <td style=\"padding: 10px;\"><strong>Receipt Number:</strong></td>\n                <td>{{ doc.receipt_number or \"Not Issued\" }}</td>\n            </tr>\n\n            <tr>\n                <td style=\"padding: 10px;\"><strong>Shop:</strong></td>\n                <td>{{ doc.shop }}</td>\n            </tr>\n\n            <tr>\n                <td style=\"padding: 10px;\"><strong>Tenant:</strong></td>\n                <td>{{ doc.tenant }}</td>\n            </tr>\n\n            <tr>\n                <td style=\"padding: 10px;\"><strong>Rent Month:</strong></td>\n                <td>{{ frappe.format_date(doc.payment_month) }}</td>\n            </tr>\n\n            <tr>\n                <td style=\"padding: 10px;\"><strong>Due Date:</strong></td>\n                <td>{{ frappe.format_date(doc.due_date) }}</td>\n            </tr>\n\n            <tr>\n                <td style=\"padding: 10px;\"><strong>Payment Date:</strong></td>\n                <td>\n                    {% if doc.payment_date %}\n                        {{ frappe.format_date(doc.payment_date) }}\n                    {% else %}\n                        Not Paid Yet\n                    {% endif %}\n                </td>\n            </tr>\n\n            <tr>\n                <td style=\"padding: 10px;\"><strong>Status:</strong></td>\n                <td>\n                    {% if doc.status == \"Paid\" %}\n                        <span style=\"color: green; font-weight: bold;\">PAID</span>\n                    {% else %}\n                        <span style=\"color: red; font-weight: bold;\">\n                            {{ doc.status | upper }}\n                        </span>\n                    {% endif %}\n                </td>\n            </tr>\n\n        </table>\n    </div>\n\n    <div style=\"\n        margin-top: 30px;\n        padding: 20px;\n        background-color: #f1f5f9;\n        border: 1px solid #ddd;\n        text-align: center;\n    \">\n        <h3 style=\"margin: 0;\">TOTAL AMOUNT</h3>\n        <h2 style=\"margin-top: 10px;\">\n            {{ doc.get_formatted(\"amount\") }}\n        </h2>\n    </div>\n\n    <div style=\"margin-top: 45px; text-align: center; color: #666;\">\n        {% if doc.status == \"Paid\" %}\n            <p>Thank you for your payment.</p>\n            <p>This receipt confirms the recorded rent payment.</p>\n        {% else %}\n            <p>This document is not a payment confirmation.</p>\n        {% endif %}\n\n        <hr>\n\n        <small>Generated by Airport Shop Management System</small>\n    </div>\n\n</div>",
